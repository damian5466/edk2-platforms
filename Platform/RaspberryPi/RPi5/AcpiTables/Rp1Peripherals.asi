/** @file
 *
 *  Enumeration descriptions for Raspberry Pi 5.
 *  Register maps: Raspberry Pi downstream Linux bcm2712*.dtsi and rp1.dtsi.
 *
 *  SPDX-License-Identifier: BSD-2-Clause-Patent
 *
 **/

// Included inside \\_SB.RP1B after Rp1.asi.
// The parent owns the firmware-assigned BAR and hides its children if absent.
// Local RP1 interrupt numbers are NOT GIC GSIs: all children use PINT (261).
// Only USB interrupt forwarding is enabled by firmware. A future RP1-aware
// driver must configure/demultiplex its local sources; enumeration does no I/O.
// CSI/DSI and DPI/VEC share configuration registers and are grouped accordingly.

#define RP1_DEVICE_INFO(Hid, Uid, Description)                 \
  Name (_HID, Hid)                                              \
  Name (_UID, Uid)                                              \
  Name (_DDN, Description)                                     \
  Name (_CCA, 0)                                               \
  Method (_STA, 0, NotSerialized) {                            \
    Return (\_SB.RP1B._STA ())                                \
  }

#define RP1_DEVICE_IRQ(Irq)                                    \
  Name (_DSD, Package () {                                      \
    ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301"),             \
    Package () {                                               \
      Package () { "raspberrypi,rp1-interrupts", Package () { Irq } } \
    }                                                          \
  })

#define RP1_SIMPLE_DEVICE(Dev, Hid, Uid, Description, Offset, Length, Irq) \
  Device (Dev) {                                               \
    RP1_DEVICE_INFO (Hid, Uid, Description)                     \
    Method (_CRS, 0, Serialized) {                             \
      Name (RBUF, ResourceTemplate () {                       \
        RP1_QWORDMEMORY_BUF (00)                              \
        RP1_INTERRUPT_BUF (99)                                \
      })                                                       \
      RP1_QWORDMEMORY_SET (00, Offset, Length)                 \
      RP1_INTERRUPT_SET (99)                                  \
      Return (RBUF)                                            \
    }                                                          \
    RP1_DEVICE_IRQ (Irq)                                      \
  }

Device (ETH0) {
  RP1_DEVICE_INFO ("RPI0001", 0x0, "RP1 Gigabit Ethernet (Cadence GEM)")
  Name (_CLS, Package () { 0x02, 0x00, 0x00 })

  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
      RP1_INTERRUPT_BUF (99)
    })
    RP1_QWORDMEMORY_SET (00, RP1_ETH_BASE, 0x4000)
    RP1_INTERRUPT_SET (99)
    Return (RBUF)
  }

  RP1_DEVICE_IRQ (0x6)
}

Device (GPI0) {
  RP1_DEVICE_INFO ("RPI0002", 0x0, "RP1 GPIO and pin control")

  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
      RP1_QWORDMEMORY_BUF (01)
      RP1_QWORDMEMORY_BUF (02)
      RP1_INTERRUPT_BUF (99)
    })
    RP1_QWORDMEMORY_SET (00, RP1_IO_BANK0_BASE, 0xC000)
    RP1_QWORDMEMORY_SET (01, RP1_SYS_RIO0_BASE, 0xC000)
    RP1_QWORDMEMORY_SET (02, RP1_PADS_BANK0_BASE, 0xC000)
    RP1_INTERRUPT_SET (99)
    Return (RBUF)
  }

  Name (_DSD, Package () {
    ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301"),
    Package () {
      Package () { "raspberrypi,rp1-interrupts", Package () { 0x0, 0x1, 0x2 } }
    }
  })
}

Device (CLK0) {
  RP1_DEVICE_INFO ("RPI0003", 0x0, "RP1 clocks and PLLs")

  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
    })
    RP1_QWORDMEMORY_SET (00, RP1_CLOCKS_MAIN_BASE, 0x10038)
    Return (RBUF)
  }
}

