Device (PWM1) {
  RP1_DEVICE_INFO ("RPI0008", 0x1, "RP1 PWM 1 (fan connector)")
  // Patched only after the board policy detected and initialized the fan.
  // Preserve the generic PWM identity and resources. The compatible identity
  // contracts GPIO45, channel 3, inverted mark/space, 50 MHz / 2078 ticks.
  Name (FNRD, 0xFF)
  Method (_CID, 0, NotSerialized) {
    If (FNRD == 1) { Return ("RPI00F1") }
    // Keep a valid ID in the no-handoff case. The initial Windows trial with
    // an empty _CID fallback stopped with ACPI_BIOS_ERROR.
    Return ("RPI0008")
  }
  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
      RP1_INTERRUPT_BUF (99)
    })
    RP1_QWORDMEMORY_SET (00, RP1_PWM1_BASE, 0x100)
    RP1_INTERRUPT_SET (99)
    Return (RBUF)
  }
  RP1_DEVICE_IRQ (0x29)
}

