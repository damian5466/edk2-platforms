    RP1_QWORDMEMORY_SET (00, RP1_MIPI0_CSIDMA_BASE, 0x100)
    RP1_QWORDMEMORY_SET (01, RP1_MIPI0_CSIHOST_BASE, 0x100)
    RP1_QWORDMEMORY_SET (02, RP1_MIPI0_DSIDMA_BASE, 0x1000)
    RP1_QWORDMEMORY_SET (03, RP1_MIPI0_DSIHOST_BASE, 0x1000)
    RP1_QWORDMEMORY_SET (04, RP1_MIPI0_CFG_BASE, 0x1000)
