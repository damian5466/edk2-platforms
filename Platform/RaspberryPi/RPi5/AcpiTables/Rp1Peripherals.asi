Device (SDI0) {
  RP1_DEVICE_INFO ("RPI000C", 0x0, "RP1 SDIO controller 0")

  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      RP1_QWORDMEMORY_BUF (00)
      RP1_QWORDMEMORY_BUF (01)
      RP1_INTERRUPT_BUF (99)
    })
    RP1_QWORDMEMORY_SET (00, RP1_SDIO0_BASE, 0x100)
    RP1_QWORDMEMORY_SET (01, RP1_SDIO0_CFG_BASE + 4, 0x1C)
    RP1_INTERRUPT_SET (99)
    Return (RBUF)
  }

  RP1_DEVICE_IRQ (0x11)
}

