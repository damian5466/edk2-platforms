Device (GIO0) {
  Name (_HID, "RPI1020")
  Name (_UID, 0)
  Name (_DDN, "BCM2712 GPIO and pin control")
  Name (_CCA, 0)
  Method (_STA, 0, NotSerialized) {
    If ((SREV == 0) || (SREV == 1)) {
      Return (0x0F)
    }
    Return (0)
  }

  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      QWORDMEMORY_BUF (00, ResourceConsumer)
      QWORDMEMORY_BUF (01, ResourceConsumer)
      QWORDMEMORY_BUF (02, ResourceConsumer)
      Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { 276 }
    })
    Local0 = 0x30
    If (SREV == 1) {
      Local0 = 0x20
    }
    QWORD_SET (00, 0x107D508500, 0x40, 0)
    QWORD_SET (01, 0x107D504100, Local0, 0)
    QWORD_SET (02, 0x107D508400, 0x10, 0)
    Return (RBUF)
  }
}

Device (GIO1) {
  Name (_HID, "RPI1020")
  Name (_UID, 1)
  Name (_DDN, "BCM2712 always-on GPIO and pin control")
  Name (_CCA, 0)
  Method (_STA, 0, NotSerialized) {
    If ((SREV == 0) || (SREV == 1)) {
      Return (0x0F)
    }
    Return (0)
  }

  Method (_CRS, 0, Serialized) {
    Name (RBUF, ResourceTemplate () {
      QWORDMEMORY_BUF (00, ResourceConsumer)
      QWORDMEMORY_BUF (01, ResourceConsumer)
    })
    Local0 = 0x20
    If (SREV == 1) {
      Local0 = 0x1C
    }
    QWORD_SET (00, 0x107D517C00, 0x40, 0)
    QWORD_SET (01, 0x107D510700, Local0, 0)
    Return (RBUF)
  }
}

// Keep the Bluetooth radio in the system scope so its identity does not
// depend on a driver enumerating children of the UART. The UART and shutdown
// line are real UART/GPIO connections for the native transport driver.
Device (BTH0) {
  Name (_HID, "RPI1017")
  Name (_UID, 0)
  Name (_DDN, "CYW43455 Bluetooth radio")
  Name (_DEP, Package () { \_SB.BTU0, \_SB.GIO0 })
  Name (BADR, ACPI_PATCH_QWORD_VALUE)
  Method (BMAC, 0, NotSerialized) {
    If ((BADR == 0) || (BADR == ACPI_PATCH_QWORD_VALUE)) { Return (0) }
    Local0 = ToBuffer (BADR)
    Return (Mid (Local0, 0, 6))
  }
  Method (_STA, 0, NotSerialized) {
    Return (\_SB.GIO0._STA ())
  }
  Name (_CRS, ResourceTemplate () {
    UartSerialBusV2 (115200, DataBitsEight, StopBitsOne, 0xC0,
      LittleEndian, ParityTypeNone, FlowControlHardware,
      32, 32, "\\_SB.BTU0", 0, ResourceConsumer, , Exclusive)
    GpioIo (Exclusive, PullDefault, 0, 0, IoRestrictionOutputOnly,
      "\\_SB.GIO0", 0, ResourceConsumer, , ) { 29 }
  })
}

// The RTC is inside the PMIC and is accessed through firmware messages.
// It has no independent CPU MMIO resource. EFI GetTime/SetTime remain in use.
Device (RTC0) {
  Name (_HID, "RPI101B")
  Name (_UID, 0)
  Name (_DDN, "Raspberry Pi 5 firmware RTC")
  Name (_STA, 0x0F)
  Name (_DSD, Package () {
    ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301"),
    Package () {
      Package () { "raspberrypi,firmware", "\\_SB.MBX0" }
    }
  })
}
