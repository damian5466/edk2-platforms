Device (BTU0) {
  Name (_HID, "RPI1016")
  Name (_UID, 0)
  Name (_DDN, "BCM2712 Bluetooth UART")
  Name (_STA, 0x0F)
  Name (_CCA, 0)
  Name (_DEP, Package () { \_SB.GIO0 })
  // Typed boot-DT metadata avoids traversing the full graph during PnP start.
  Name (UCKH, ACPI_PATCH_DWORD_VALUE)
  Method (UCLK, 0, NotSerialized) { Return (UCKH) }

  Name (RBUF, ResourceTemplate () {
    BCM2712_MMIO (0x107D50C000, 0x107D50C01F, 0x20)
    Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { 308 }
    PinFunction (Exclusive, PullDefault, 4, "\\_SB.GIO0", 0, ResourceConsumer, RTS0, ) { 24 }
    PinFunction (Exclusive, PullDefault, 4, "\\_SB.GIO0", 0, ResourceConsumer, , ) { 25, 26, 27 }
  })
  CreateWordField (RBUF, RTS0._FUN, RFUN)
  Method (_CRS, 0, Serialized) {
    // C0 routes RTS on function 3; D0 routes all four UART pins on 4.
    If (SREV == 0) { RFUN = 3 } Else { RFUN = 4 }
    Return (RBUF)
  }
}

