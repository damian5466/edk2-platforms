/** @file
 *
 *  Enumeration descriptions for Raspberry Pi 5.
 *  Register maps: Raspberry Pi downstream Linux bcm2712*.dtsi and rp1.dtsi.
 *
 *  SPDX-License-Identifier: BSD-2-Clause-Patent
 *
 **/

// Included directly in \\_SB. These AXI masters must not inherit SOCB's
// legacy 1 GiB DMA translation. Addresses are CPU physical, not VPU bus aliases.
// HIDs are project-local enumeration IDs; no Pi 3/4 or generic driver CIDs.
//
// SPI values in the Raspberry Pi DT are converted to GIC GSIs by adding 32.
// Cascaded display interrupts are described by their parent GIC lines together
// with the L2 controller registers, not by treating local bits as GIC numbers.

#define BCM2712_MMIO(Base, Last, Length)                              \
  QWordMemory (ResourceConsumer, PosDecode,                    \
    MinFixed, MaxFixed, NonCacheable, ReadWrite,                \
    0, Base, Last, 0, Length)

// Patched only after recognizing the bootloader's C0/C1 or D0 pinctrl pair.
// Unknown layouts hide the GPIO/pinctrl devices rather than claiming C1 sizes.
Name (SREV, ACPI_PATCH_BYTE_VALUE)

Device (GPU0) {
  Name (_HID, "RPI1000")
  Name (_UID, 0)
  Name (_DDN, "BCM2712 VideoCore VII V3D GPU")
  Name (_STA, 0x0F)
  Name (_CCA, 0)
  Name (_CLS, Package () { 0x03, 0x02, 0x00 })

  Name (_CRS, ResourceTemplate () {
    BCM2712_MMIO (0x1002000000, 0x1002003FFF, 0x4000)
    BCM2712_MMIO (0x1002008000, 0x100200DFFF, 0x6000)
    BCM2712_MMIO (0x1002030800, 0x1002030EFF, 0x700)
    Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { 282, 281 }
  })
}

Device (DISP) {
  Name (_HID, "RPI1001")
  Name (_UID, 0)
  Name (_DDN, "BCM2712 display engine and dual HDMI audio/video")
  Name (_STA, 0x0F)
  Name (_CCA, 0)
  // HVS, pixel valves, MOP/MOPLET, DVP, HDMI0/1, DDC and L2 IRQs.
  // Both HDMI blocks share the HD register; reserve it only once.

  Name (_CRS, ResourceTemplate () {
    BCM2712_MMIO (0x107C580000, 0x107C599FFF, 0x1A000)
    BCM2712_MMIO (0x107C410000, 0x107C4100FF, 0x100)
    BCM2712_MMIO (0x107C411000, 0x107C4110FF, 0x100)
    BCM2712_MMIO (0x107C500000, 0x107C500027, 0x28)
    BCM2712_MMIO (0x107C501000, 0x107C50101F, 0x20)
    BCM2712_MMIO (0x107C502000, 0x107C50202F, 0x30)
    BCM2712_MMIO (0x107C700000, 0x107C70000F, 0x10)
    BCM2712_MMIO (0x107C720000, 0x107C7200FF, 0x100)
    BCM2712_MMIO (0x107D510600, 0x107D51062F, 0x30)
    BCM2712_MMIO (0x107D508200, 0x107D508257, 0x58)
    BCM2712_MMIO (0x107D508280, 0x107D5082D7, 0x58)
    BCM2712_MMIO (0x107D508380, 0x107D50838F, 0x10)
    BCM2712_MMIO (0x107C701400, 0x107C7016FF, 0x300)
    BCM2712_MMIO (0x107C701000, 0x107C7011FF, 0x200)
    BCM2712_MMIO (0x107C701D00, 0x107C701FFF, 0x300)
    BCM2712_MMIO (0x107C702000, 0x107C70207F, 0x80)
    BCM2712_MMIO (0x107C703800, 0x107C7039FF, 0x200)
    BCM2712_MMIO (0x107C704000, 0x107C7047FF, 0x800)
    BCM2712_MMIO (0x107C706400, 0x107C7066FF, 0x300)
    BCM2712_MMIO (0x107C706000, 0x107C7061FF, 0x200)
    BCM2712_MMIO (0x107C706D00, 0x107C706FFF, 0x300)
    BCM2712_MMIO (0x107C707000, 0x107C70707F, 0x80)
    BCM2712_MMIO (0x107C708800, 0x107C7089FF, 0x200)
    BCM2712_MMIO (0x107C709000, 0x107C7097FF, 0x800)
    BCM2712_MMIO (0x107C700100, 0x107C70017F, 0x80)
    BCM2712_MMIO (0x107C700180, 0x107C7001FF, 0x80)
    BCM2712_MMIO (0x107D510800, 0x107D5108FF, 0x100)
    BCM2712_MMIO (0x107D511000, 0x107D5110FF, 0x100)
    Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { 129, 133, 142, 271, 274 }
  })
}

